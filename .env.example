RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=your_test_key_secret
RZP_WEBHOOK_SECRET=your_webhook_secret
DATABASE_URL=sqlite:///./recoverai.db
AGENT_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Optional — WhatsApp via Twilio. Without these, WhatsApp runs in honest
# simulated mode (delivery recorded as "simulated", never claimed as sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional — Sarvam AI for Hinglish voice TTS. Without this, voice calls are
# recorded as bounded call scripts only.
SARVAM_API_KEY=
